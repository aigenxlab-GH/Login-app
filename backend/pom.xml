<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.aigenxlab</groupId>
    <artifactId>login-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>login-app</name>
    <description>Production-style single-jar Spring Boot + React login app</description>

    <properties>
        <java.version>21</java.version>
        <frontend.dir>${project.basedir}/../frontend</frontend.dir>
        <!-- springdoc 2.x supports Spring Boot 3.x -->
        <springdoc.version>2.6.0</springdoc.version>
        <!-- Argon2 password hashing via argon2-jvm (bundles native libs) -->
        <argon2.version>2.11</argon2.version>
    </properties>

    <dependencies>
        <!-- ── Web & REST ──────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── Security (filter chain only — no form login, no basic auth) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ── JDBC (no JPA / Hibernate) ──────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- ── Input validation ───────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── Actuator (/actuator/health) ────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── OpenAPI / Swagger UI (/swagger-ui, /v3/api-docs) ───────────── -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ── Postgres driver ────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Flyway (SQL migrations) ────────────────────────────────────── -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ── Argon2id password hashing (bundles native libs for Win/Linux/Mac) -->
        <dependency>
            <groupId>de.mkammerer</groupId>
            <artifactId>argon2-jvm</artifactId>
            <version>${argon2.version}</version>
        </dependency>

        <!-- ── Test ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- spring-boot-starter-test already includes mockito-core -->
        </dependency>
    </dependencies>

    <build>
        <finalName>login-app</finalName>
        <plugins>

            <!-- ── -1. Compiler — enable all Xlint warnings ──────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Xlint:-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- ── 0. Extend 'clean' to also wipe the generated static dir ─────── -->
            <!--     Without this, old hashed JS/CSS filenames accumulate across    -->
            <!--     builds because maven-resources-plugin only overwrites, never   -->
            <!--     deletes.  Adding the directory here means `mvn clean package`  -->
            <!--     always produces a JAR with exactly one set of SPA assets.      -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${project.basedir}/src/main/resources/static</directory>
                            <includes><include>**/*</include></includes>
                            <followSymlinks>false</followSymlinks>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>

            <!-- ── 1. Build React frontend (Node pre-installed on build host) ─ -->
            <!--     Assumes node + npm are on PATH.  Does NOT download Node.    -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>
                <configuration>
                    <workingDirectory>${frontend.dir}</workingDirectory>
                    <!-- No <installDirectory>: plugin uses system PATH node/npm -->
                </configuration>
                <executions>
                    <execution>
                        <id>npm-install</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration><arguments>install</arguments></configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration><arguments>run build</arguments></configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ── 2. Re-copy static into target/classes at prepare-package ─── -->
            <!--                                                                  -->
            <!-- Race condition workaround: on Windows, frontend-maven-plugin's   -->
            <!-- npm process can return to Maven *before* the OS flushes Vite's   -->
            <!-- output files to disk. The result: the default process-resources  -->
            <!-- copies an empty (or partial) static/ into target/classes, and    -->
            <!-- the JAR ships without the SPA assets ("No static resource .").   -->
            <!--                                                                  -->
            <!-- Fix: run a second copy at prepare-package (after compile, well   -->
            <!-- after npm has fully released its file handles). This idempotent  -->
            <!-- copy guarantees target/classes/static is populated before the    -->
            <!-- JAR is assembled in the package phase.                           -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <!-- Step A: re-copy static at prepare-package (race fix). -->
                    <execution>
                        <id>refresh-frontend-static</id>
                        <phase>prepare-package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <copy todir="${project.build.outputDirectory}/static"
                                      overwrite="true" failonerror="false">
                                    <fileset dir="${project.basedir}/src/main/resources/static" erroronmissingdir="false"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                    <!-- Step B: hard fail if the Vite output is still missing.   -->
                    <!-- This prevents shipping a JAR that returns                -->
                    <!-- {"code":"NOT_FOUND","message":"No static resource ."}.   -->
                    <execution>
                        <id>verify-frontend-static</id>
                        <phase>prepare-package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <fail message="
                                    ============================================================
                                    BUILD ABORTED: Vite output is missing.
                                    target/classes/static/index.html does not exist.
                                    ============================================================
                                    The frontend-maven-plugin reported success but no SPA
                                    assets were copied into the JAR. Common causes:
                                      1. Vite build silently failed (check for TypeScript
                                         errors with: cd frontend &amp;&amp; npx tsc --noEmit)
                                      2. vite.config.ts outDir is wrong (must be
                                         '../backend/src/main/resources/static')
                                      3. Filesystem race (rare; rerun mvnw clean package)
                                    Do NOT ship this JAR — the app would be broken.
                                    ============================================================">
                                    <condition>
                                        <not>
                                            <available file="${project.build.outputDirectory}/static/index.html"/>
                                        </not>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ── 3. Package fat JAR (spring-boot:repackage) ──────────────── -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
