# ============================================================
# .env.example — copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Spring profile ---
# Change to "prod" on production server
SPRING_PROFILES_ACTIVE=local

# --- Supabase Postgres (JDBC) ---
# Get from: Supabase Dashboard → Project → Settings → Database
#           → Connection string → URI tab → JDBC format
#
# Use the Supabase connection pooler (port 6543) for production
# workloads; use the direct connection (port 5432) for migrations.

# JDBC URL — sslmode=require is mandatory for Supabase
DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase DB username format: postgres.<project-ref>
DATABASE_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx

# Your Supabase project database password
DATABASE_PASSWORD=your-supabase-db-password-here

# --- Auth ---
# Server-side pepper mixed into every password hash.
# Generate with: openssl rand -hex 32
AUTH_PASSWORD_PEPPER=change-me-use-a-long-random-secret

# --- Server ---
# Port the Spring Boot jar listens on (default: 8080)
PORT=8080
